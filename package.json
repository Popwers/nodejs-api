{
  "name": "node-js-template",
  "version": "1.0.0",
  "description": "API node.js template",
  "main": "index.js",
  "author": "Lionel Bataille",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bufferutil": "^4.2.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "formidable": "^3.5.4",
    "jsonwebtoken": "^9.0.3",
    "mysql": "^2.18.1",
    "socket.io": "^4.8.4",
    "utf-8-validate": "^6.0.6"
  },
  "release": {
    "branches": [
      "master"
    ],
    "repositoryUrl": "https://github.com/Popwers/nodejs-api.git",
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/github",
        {
          "releaseBody": "Release ${nextRelease.version}"
        }
      ]
    ]
  }
}
